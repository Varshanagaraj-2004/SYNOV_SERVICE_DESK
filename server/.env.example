MONGO_URI=mongodb://localhost:27017/synov-service-desk
PORT=5050
LOG_LEVEL=info
# generate with: npm run gen:secret
JWT_SECRET=
# URL users open in their browser; email links are built from this URL.
FRONTEND_URL=http://localhost:5173,http://192.168.0.52:5173
# Optional extra CORS origins; local network origins are allowed automatically.
CORS_ORIGINS=

# SMTP = sending (smtp.gmail.com:587)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=Synov Service Desk <support@example.com>
IT_TEAM_EMAIL=it-team@example.com

# IMAP = reading the support inbox (imap.gmail.com:993)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=your-imap-user
IMAP_PASS=your-imap-password
IMAP_ALLOW_SELF_SIGNED=false
IMAP_REQUIRE_AUTH_RESULTS=true

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional email classification
ANTHROPIC_API_KEY=

# CRM integration
CRM_LOGIN_URL=
CRM_USERNAME=
CRM_PASSWORD=
CRM_CUSTOMERS_URL=
INVENTORY_API_URL=

# Optional test-mail account; otherwise Nodemailer creates one automatically.
# ETHEREAL_USER=your-ethereal-user
# ETHEREAL_PASS=your-ethereal-password